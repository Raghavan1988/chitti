# Copy to .env and export, or: set -a; source .env; set +a

# Model (Odysseus provider)
ODYSSEUS_API_KEY=
# GEMINI_API_KEY=          # fallback if ODYSSEUS_API_KEY unset
# ODYSSEUS_MODEL=gemini-3.1-pro-preview

# Mobile harness server
CHITTI_API_KEY=dev-key-change-me
CHITTI_HOST=0.0.0.0
CHITTI_PORT=8787
CHITTI_POLICY=safe
# CHITTI_WORKDIR=/absolute/path/to/server/workspace
# CHITTI_APPROVAL_TIMEOUT=300
# CHITTI_MAX_TURNS=40
